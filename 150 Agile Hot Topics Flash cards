  { id: 149, category: "XP", title: "Evolutionary Design", text: "Practicing design so that the system architecture grows as the team learns.", icon: <Lightbulb className="text-blue-500" />, color: "bg-blue-50 border-blue-200" },
  { id: 150, category: "Lean", title: "Handoff", text: "The act of passing work from one person to another; considered a form of waste in Lean.", icon: <Shuffle className="text-emerald-500" />, color: "bg-emerald-50 border-emerald-200" },
];

const App = () => {
  const [deck, setDeck] = useState([]);
  const [currentIndex, setCurrentIndex] = useState(0);
  const [isFlipped, setIsFlipped] = useState(false);
  const [masteredIds, setMasteredIds] = useState(new Set());
  const [needsReviewIds, setNeedsReviewIds] = useState(new Set());

  // Initialize and shuffle deck
  useEffect(() => {
    shuffleDeck();
  }, []);

  const shuffleDeck = () => {
    const shuffled = [...topicsData].sort(() => Math.random() - 0.5);
    setDeck(shuffled);
    setCurrentIndex(0);
    setIsFlipped(false);
  };

  const currentCard = deck[currentIndex];

  const handleNext = () => {
    setIsFlipped(false);
    setTimeout(() => {
      setCurrentIndex((prev) => (prev + 1) % deck.length);
    }, 150);
  };

  const handlePrev = () => {
    setIsFlipped(false);
    setTimeout(() => {
      setCurrentIndex((prev) => (prev - 1 + deck.length) % deck.length);
    }, 150);
  };

  const toggleMastered = (id) => {
    setMasteredIds(prev => {
      const next = new Set(prev);
      if (next.has(id)) next.delete(id);
      else {
        next.add(id);
        setNeedsReviewIds(prevReview => {
          const nextReview = new Set(prevReview);
          nextReview.delete(id);
          return nextReview;
        });
      }
      return next;
    });
  };

  const toggleNeedsReview = (id) => {
    setNeedsReviewIds(prev => {
      const next = new Set(prev);
      if (next.has(id)) next.delete(id);
      else {
        next.add(id);
        setMasteredIds(prevMastered => {
          const nextMastered = new Set(prevMastered);
          nextMastered.delete(id);
          return nextMastered;
        });
      }
      return next;
    });
  };

  if (!currentCard) return <div className="p-10 text-center text-slate-500 font-bold">Loading Flashcards...</div>;

  const progressPercent = Math.round((masteredIds.size / topicsData.length) * 100);

  return (
    <div className="min-h-screen bg-slate-100 flex flex-col font-sans text-slate-900 overflow-x-hidden">
      {/* Header */}
      <header className="bg-white border-b border-slate-200 px-4 sm:px-6 py-4 flex flex-wrap items-center justify-between gap-4 sticky top-0 z-20 shadow-sm">
        <div className="flex items-center gap-3">
          <div className="bg-indigo-600 p-2 rounded-lg text-white">
            <Zap size={24} />
          </div>
          <div>
            <h1 className="text-lg sm:text-xl font-black tracking-tight leading-none uppercase">Agile Master Deck</h1>
            <p className="text-[10px] sm:text-xs font-bold text-slate-400 uppercase tracking-widest mt-1">150 Practice Guide Topics</p>
          </div>
        </div>

        <div className="flex items-center gap-4 sm:gap-6 flex-1 justify-end">
          <div className="hidden lg:block">
            <div className="flex justify-between text-[10px] font-bold text-slate-400 mb-1 uppercase tracking-tighter">
              <span>Overall Mastery</span>
              <span>{progressPercent}% ({masteredIds.size}/150)</span>
            </div>
            <div className="w-48 h-2 bg-slate-200 rounded-full overflow-hidden">
              <div 
                className="h-full bg-indigo-500 transition-all duration-1000 ease-out" 
                style={{ width: `${progressPercent}%` }}
              ></div>
            </div>
          </div>
          
          <div className="flex items-center gap-2">
            <button 
              onClick={shuffleDeck}
              className="flex items-center gap-2 bg-slate-100 hover:bg-slate-200 text-slate-700 px-3 sm:px-4 py-2 rounded-lg text-xs sm:text-sm font-bold transition-colors whitespace-nowrap"
            >
              <Shuffle size={16} /> Shuffle
            </button>
            <button 
              onClick={() => {
                setMasteredIds(new Set());
                setNeedsReviewIds(new Set());
                shuffleDeck();
              }}
              className="hidden sm:flex items-center gap-2 bg-slate-100 hover:bg-slate-200 text-slate-700 px-4 py-2 rounded-lg text-sm font-bold transition-colors"
            >
              <RotateCcw size={16} /> Reset
            </button>
          </div>
        </div>
      </header>

      {/* Main Flashcard View */}
      <main className="flex-1 flex flex-col items-center justify-center p-4 sm:p-6 relative overflow-hidden">
        
        {/* Statistics Floating Panel (Desktop) */}
        <div className="absolute top-8 left-8 hidden xl:flex flex-col gap-4">
          <div className="bg-white p-4 rounded-xl shadow-sm border border-slate-200 w-48 hover:shadow-md transition-shadow">
            <div className="flex items-center gap-2 text-green-600 font-bold mb-1">
              <Trophy size={18} /> Mastered
            </div>
            <div className="text-3xl font-black text-slate-800">{masteredIds.size}</div>
            <div className="text-[10px] text-slate-400 font-bold uppercase mt-1 tracking-widest">Confidence High</div>
          </div>
          <div className="bg-white p-4 rounded-xl shadow-sm border border-slate-200 w-48 hover:shadow-md transition-shadow">
            <div className="flex items-center gap-2 text-orange-500 font-bold mb-1">
              <HelpCircle size={18} /> Reviewing
            </div>
            <div className="text-3xl font-black text-slate-800">{needsReviewIds.size}</div>
            <div className="text-[10px] text-slate-400 font-bold uppercase mt-1 tracking-widest">Needs Work</div>
          </div>
        </div>

        {/* The Card Container */}
        <div className="relative w-full max-w-xl aspect-[4/3] sm:h-[400px] perspective-1000 group">
          <div 
            onClick={() => setIsFlipped(!isFlipped)}
            className={`relative w-full h-full transition-transform duration-500 transform-style-3d cursor-pointer ${isFlipped ? 'rotate-y-180' : ''}`}
          >
            {/* Front Side */}
            <div className={`absolute inset-0 backface-hidden rounded-3xl border-b-[6px] sm:border-b-8 shadow-xl sm:shadow-2xl flex flex-col items-center justify-center p-6 sm:p-12 text-center border ${currentCard.color} transition-all`}>
              <div className="mb-4 sm:mb-6 transform scale-125 sm:scale-150 p-4 bg-white/50 rounded-full shadow-inner">
                {currentCard.icon}
              </div>
              <span className="text-[10px] sm:text-xs font-black uppercase tracking-[0.2em] text-slate-400 mb-2">
                {currentCard.category}
              </span>
              <h2 className="text-2xl sm:text-4xl font-black text-slate-800 leading-tight">
                {currentCard.title}
              </h2>
              <div className="mt-6 sm:mt-10 flex items-center gap-2 text-indigo-500 font-bold animate-bounce text-xs sm:text-sm">
                <RotateCcw size={16} /> Tap to reveal logic
              </div>
            </div>

            {/* Back Side */}
            <div className={`absolute inset-0 backface-hidden rotate-y-180 rounded-3xl border-b-[6px] sm:border-b-8 shadow-xl sm:shadow-2xl flex flex-col items-center justify-center p-6 sm:p-12 text-center border bg-white border-indigo-200 transition-all`}>
              <span className="text-[10px] sm:text-xs font-black uppercase tracking-[0.2em] text-indigo-400 mb-4 sm:mb-6">
                Expert Breakdown
              </span>
              <p className="text-lg sm:text-2xl font-bold text-slate-700 leading-relaxed italic px-2">
                "{currentCard.text}"
              </p>
              <div className="mt-8 sm:mt-10 flex items-center gap-2 text-slate-400 font-bold text-xs">
                <RotateCcw size={16} /> Tap to flip back
              </div>
            </div>
          </div>
        </div>

        {/* Controls */}
        <div className="mt-8 sm:mt-12 w-full max-w-xl flex flex-col gap-4 sm:gap-6">
          <div className="flex items-center justify-between gap-3 sm:gap-4">
            <button 
              onClick={handlePrev}
              className="p-3 sm:p-4 bg-white hover:bg-slate-50 border border-slate-200 text-slate-600 rounded-2xl shadow-sm transition-all active:scale-90"
            >
              <ChevronLeft size={24} />
            </button>
            
            <div className="flex-1 flex gap-2 sm:gap-3">
              <button 
                onClick={(e) => { e.stopPropagation(); toggleNeedsReview(currentCard.id); }}
                className={`flex-1 flex items-center justify-center gap-2 py-3 sm:py-4 rounded-2xl font-bold text-sm sm:text-base transition-all ${
                  needsReviewIds.has(currentCard.id) 
                  ? 'bg-orange-500 text-white shadow-lg shadow-orange-200 scale-105' 
                  : 'bg-white border border-slate-200 text-orange-500 hover:bg-orange-50'
                }`}
              >
                <HelpCircle size={20} className="hidden sm:inline" /> Learning
              </button>
              
              <button 
                onClick={(e) => { e.stopPropagation(); toggleMastered(currentCard.id); }}
                className={`flex-1 flex items-center justify-center gap-2 py-3 sm:py-4 rounded-2xl font-bold text-sm sm:text-base transition-all ${
                  masteredIds.has(currentCard.id) 
                  ? 'bg-green-500 text-white shadow-lg shadow-green-200 scale-105' 
                  : 'bg-white border border-slate-200 text-green-600 hover:bg-green-50'
                }`}
              >
                <CheckCircle size={20} className="hidden sm:inline" /> Mastered
              </button>
            </div>

            <button 
              onClick={handleNext}
              className="p-3 sm:p-4 bg-white hover:bg-slate-50 border border-slate-200 text-slate-600 rounded-2xl shadow-sm transition-all active:scale-90"
            >
              <ChevronRight size={24} />
            </button>
          </div>

          <div className="text-center font-bold text-slate-400 text-xs sm:text-sm uppercase tracking-widest">
            Topic {currentIndex + 1} of {deck.length}
          </div>
        </div>
      </main>

      {/* CSS for 3D flip effect */}
      <style dangerouslySetInnerHTML={{ __html: `
        .perspective-1000 {
          perspective: 1000px;
        }
        .backface-hidden {
          backface-visibility: hidden;
        }
        .transform-style-3d {
          transform-style: preserve-3d;
        }
        .rotate-y-180 {
          transform: rotateY(180deg);
        }
      `}} />

      {/* Mobile/Tablet Footer Stats */}
      <footer className="xl:hidden bg-white border-t border-slate-200 p-4 grid grid-cols-2 gap-4 sticky bottom-0 z-10">
        <div className="flex flex-col items-center justify-center border-r border-slate-100">
          <span className="text-[10px] font-black text-slate-400 uppercase tracking-tighter mb-1">Mastered</span>
          <div className="flex items-center gap-2">
            <div className="w-2 h-2 rounded-full bg-green-500"></div>
            <span className="text-lg font-black text-slate-800">{masteredIds.size}</span>
          </div>
        </div>
        <div className="flex flex-col items-center justify-center">
          <span className="text-[10px] font-black text-slate-400 uppercase tracking-tighter mb-1">Reviewing</span>
          <div className="flex items-center gap-2">
            <div className="w-2 h-2 rounded-full bg-orange-500"></div>
            <span className="text-lg font-black text-slate-800">{needsReviewIds.size}</span>
          </div>
        </div>
      </footer>
    </div>
  );
};

export default App;
