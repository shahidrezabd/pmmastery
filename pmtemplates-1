// --- Sub-Components ---

// Refactored to be a Controlled Component
const TableInput = ({ columns, data, onChange }) => {
  // Ensure data is always an array
  const rows = Array.isArray(data) && data.length > 0 ? data : [{}];

  const addRow = () => {
    onChange([...rows, {}]);
  };

  const updateCell = (rowIndex, col, value) => {
    const newRows = [...rows];
    newRows[rowIndex] = { ...newRows[rowIndex], [col]: value };
    onChange(newRows);
  };

  const removeRow = (rowIndex) => {
    if (rows.length > 1) {
      const newRows = rows.filter((_, idx) => idx !== rowIndex);
      onChange(newRows);
    }
  };

  return (
    <div className="overflow-x-auto border border-gray-200 rounded-lg print:border-black print:border-2">
      <table className="w-full text-sm text-left text-gray-500 print:text-black">
        <thead className="text-xs text-gray-700 uppercase bg-gray-50 print:bg-gray-200 print:text-black">
          <tr>
            {columns.map((col) => (
              <th key={col} className="px-6 py-3 border-r border-gray-200 last:border-0 print:border-black min-w-[150px]">{col}</th>
            ))}
            <th className="px-2 py-3 w-10 print:hidden"></th>
          </tr>
        </thead>
        <tbody>
          {rows.map((row, rowIndex) => (
            <tr key={rowIndex} className="bg-white border-b hover:bg-gray-50 print:border-black">
              {columns.map((col) => (
                <td key={col} className="px-2 py-2 border-r border-gray-200 last:border-0 print:border-black">
                  <input
                    type="text"
                    className="w-full p-1 border-none focus:ring-0 bg-transparent print:text-black"
                    placeholder="..."
                    value={row[col] || ''}
                    onChange={(e) => updateCell(rowIndex, col, e.target.value)}
                  />
                </td>
              ))}
               <td className="px-2 py-2 text-center print:hidden">
                 {rows.length > 1 && (
                   <button 
                     onClick={() => removeRow(rowIndex)}
                     className="text-gray-400 hover:text-red-500"
                   >
                     <X size={14} />
                   </button>
                 )}
               </td>
            </tr>
          ))}
        </tbody>
      </table>
      <button 
        onClick={addRow}
        className="w-full py-2 text-sm text-blue-600 font-medium hover:bg-blue-50 transition-colors print:hidden"
      >
        + Add Row
      </button>
    </div>
  );
};

const TemplateContent = ({ template }) => {
  const [formData, setFormData] = useState({});
  const [saveStatus, setSaveStatus] = useState('idle'); // 'idle', 'saving', 'saved'

  // Load data from localStorage when template changes
  useEffect(() => {
    if (template) {
      setSaveStatus('idle');
      const savedData = localStorage.getItem(`pmi_template_${template.id}`);
      if (savedData) {
        try {
          setFormData(JSON.parse(savedData));
        } catch (e) {
          console.error("Error parsing saved data", e);
          setFormData({});
        }
      } else {
        setFormData({});
      }
    }
  }, [template]);

  const handleInputChange = (sectionTitle, value) => {
    setFormData(prev => ({
      ...prev,
      [sectionTitle]: value
    }));
    if (saveStatus === 'saved') setSaveStatus('idle');
  };

  const handleSave = () => {
    if (!template) return;
    setSaveStatus('saving');
    
    // Simulate a small delay for better UX
    setTimeout(() => {
      localStorage.setItem(`pmi_template_${template.id}`, JSON.stringify(formData));
      setSaveStatus('saved');
      
      // Reset status after 3 seconds
      setTimeout(() => setSaveStatus('idle'), 3000);
    }, 500);
  };

  const handlePrint = () => {
    window.print();
  };

  if (!template) {
    return (
      <div className="flex flex-col items-center justify-center h-full text-gray-400 print:hidden">
        <FileText size={64} className="mb-4 text-gray-200" />
        <p className="text-lg">Select a template from the sidebar to begin</p>
      </div>
    );
  }

  return (
    <div className="max-w-4xl mx-auto bg-white shadow-lg rounded-xl overflow-hidden min-h-[800px] flex flex-col print:shadow-none print:min-h-0 print:block">
      {/* Header */}
      <div className="bg-blue-700 text-white p-8 print:bg-white print:text-black print:p-0 print:mb-6 print:border-b-2 print:border-black">
        <h1 className="text-3xl font-bold mb-2 print:text-4xl">{template.name}</h1>
        <p className="text-blue-100 opacity-90 print:text-gray-600 print:italic">{template.description}</p>
      </div>

      {/* Form Body */}
      <div className="p-8 space-y-8 flex-grow print:p-0 print:space-y-6">
        {template.sections.map((section, idx) => (
          <div key={idx} className="space-y-3 print:break-inside-avoid">
            <label className="block text-sm font-bold text-gray-700 uppercase tracking-wide border-b border-gray-200 pb-1 print:text-black print:border-black">
              {section.title}
            </label>
            
            {section.type === 'textarea' && (
              <textarea 
                className="w-full min-h-[120px] p-4 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-shadow bg-gray-50 focus:bg-white resize-y print:bg-white print:border-none print:p-0 print:resize-none print:min-h-0"
                placeholder={`Enter ${section.title}...`}
                value={formData[section.title] || ''}
                onChange={(e) => handleInputChange(section.title, e.target.value)}
              />
            )}
            
            {section.type === 'text' && (
              <input 
                type="text" 
                className="w-full p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-shadow bg-gray-50 focus:bg-white print:bg-white print:border-none print:p-0"
                placeholder={`Enter ${section.title}...`}
                value={formData[section.title] || ''}
                onChange={(e) => handleInputChange(section.title, e.target.value)}
              />
            )}

            {section.type === 'table' && (
              <TableInput 
                columns={section.columns} 
                data={formData[section.title]}
                onChange={(newData) => handleInputChange(section.title, newData)}
              />
            )}
          </div>
        ))}
      </div>

      {/* Footer Actions */}
      <div className="bg-gray-50 p-6 border-t border-gray-100 flex justify-between items-center print:hidden">
        
        {/* Save Status Indicator */}
        <div className="flex items-center gap-2 h-8">
           {saveStatus === 'saved' && (
             <span className="flex items-center gap-2 text-green-600 text-sm font-medium animate-in fade-in slide-in-from-bottom-2">
               <CheckCircle size={16} /> Saved to Local Storage
             </span>
           )}
           {saveStatus === 'saving' && (
             <span className="text-gray-400 text-sm">Saving...</span>
           )}
        </div>

        <div className="flex gap-3">
          <button 
            onClick={handlePrint}
            className="flex items-center gap-2 px-4 py-2 text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 transition-colors shadow-sm active:scale-95 transform"
          >
            <Printer size={16} />
            Print / PDF
          </button>
          
          <button 
            onClick={handleSave}
            disabled={saveStatus === 'saving'}
            className={`
              flex items-center gap-2 px-6 py-2 rounded-lg text-white shadow-md transition-all active:scale-95 transform
              ${saveStatus === 'saved' ? 'bg-green-600 hover:bg-green-700' : 'bg-blue-600 hover:bg-blue-700'}
            `}
          >
            {saveStatus === 'saved' ? <Check size={16} /> : <Save size={16} />}
            {saveStatus === 'saved' ? 'Saved' : 'Save Draft'}
          </button>
        </div>
      </div>
    </div>
  );
};

// --- Main App Component ---

export default function PMITemplateApp() {
  const [activeCategory, setActiveCategory] = useState('initiation');
  const [activeTemplateId, setActiveTemplateId] = useState(null);
  const [isSidebarOpen, setIsSidebarOpen] = useState(true);

  const toggleCategory = (id) => {
    setActiveCategory(activeCategory === id ? null : id);
  };

  const handleTemplateClick = (templateId) => {
    setActiveTemplateId(templateId);
    // On mobile, close sidebar after selection
    if (window.innerWidth < 768) {
      setIsSidebarOpen(false);
    }
  };

  const currentTemplate = TEMPLATE_DATA
    .flatMap(cat => cat.templates)
    .find(t => t.id === activeTemplateId);

  return (
    <div className="flex h-screen bg-gray-100 text-slate-900 font-sans overflow-hidden print:h-auto print:overflow-visible">
      
      {/* Mobile Header - Hidden on Print */}
      <div className="md:hidden fixed top-0 w-full bg-blue-800 text-white z-20 flex items-center p-4 shadow-md print:hidden">
        <button onClick={() => setIsSidebarOpen(!isSidebarOpen)} className="p-1 mr-4">
          <Menu size={24} />
        </button>
        <h1 className="font-bold text-lg">PMBOK Toolkit</h1>
      </div>

      {/* Sidebar - Hidden on Print */}
      <aside 
        className={`
          fixed md:static inset-y-0 left-0 z-10
          w-72 bg-slate-900 text-slate-300 flex flex-col
          transform transition-transform duration-300 ease-in-out
          ${isSidebarOpen ? 'translate-x-0' : '-translate-x-full'}
          md:translate-x-0 shadow-2xl
          print:hidden
        `}
      >
        <div className="p-6 border-b border-slate-800 flex justify-between items-center bg-slate-950">
          <div className="flex items-center gap-3 text-white">
            <div className="bg-blue-600 p-2 rounded-lg">
              <Folder size={20} />
            </div>
            <div>
              <h1 className="font-bold text-lg leading-tight">PM Templates</h1>
              <span className="text-xs text-slate-400">Standard & Agile</span>
            </div>
          </div>
          <button onClick={() => setIsSidebarOpen(false)} className="md:hidden text-white">
            <X size={24} />
          </button>
        </div>

        <div className="flex-1 overflow-y-auto py-4 custom-scrollbar">
          {TEMPLATE_DATA.map((category) => (
            <div key={category.id} className="mb-1">
              <button
                onClick={() => toggleCategory(category.id)}
                className={`
                  w-full flex items-center justify-between px-6 py-3 text-sm font-medium transition-colors
                  ${activeCategory === category.id ? 'text-white bg-slate-800 border-l-4 border-blue-500' : 'hover:text-white hover:bg-slate-800/50 border-l-4 border-transparent'}
                `}
              >
                <div className="flex items-center gap-3">
                  {category.icon}
                  <span>{category.title}</span>
                </div>
                {activeCategory === category.id ? <ChevronDown size={14} /> : <ChevronRight size={14} />}
              </button>

              {/* Submenu */}
              {activeCategory === category.id && (
                <div className="bg-slate-950/30 py-2">
                  {category.templates.map((template) => (
                    <button
                      key={template.id}
                      onClick={() => handleTemplateClick(template.id)}
                      className={`
                        w-full text-left pl-14 pr-6 py-2 text-sm transition-all
                        flex items-center gap-2
                        ${activeTemplateId === template.id 
                          ? 'text-blue-400 bg-blue-900/20 font-medium' 
                          : 'text-slate-400 hover:text-slate-200 hover:bg-slate-800/30'}
                      `}
                    >
                      <FileText size={14} />
                      {template.name}
                    </button>
                  ))}
                </div>
              )}
            </div>
          ))}
        </div>
        
        <div className="p-4 border-t border-slate-800 text-xs text-slate-500 text-center">
          © 2026 PM Toolkit v1.0
        </div>
      </aside>

      {/* Main Content */}
      <main className="flex-1 overflow-y-auto pt-16 md:pt-0 relative print:overflow-visible print:h-auto print:pt-0">
        <div className="p-4 md:p-8 min-h-full print:p-0">
           <TemplateContent template={currentTemplate} />
        </div>
      </main>

      {/* Overlay for mobile when sidebar is open */}
      {isSidebarOpen && (
        <div 
          className="fixed inset-0 bg-black/50 z-0 md:hidden print:hidden"
          onClick={() => setIsSidebarOpen(false)}
        />
      )}
    </div>
  );
}
